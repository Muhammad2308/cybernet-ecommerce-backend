{
  "expo": {
    "name": "RIDO",
    "slug": "rido",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cybernet.rido",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RIDO needs location to match you with nearby travelers.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "RIDO needs background location for active deliveries.",
        "NSCameraUsageDescription": "RIDO needs camera to take delivery photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.cybernet.rido",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {}
  }
}
