# ─── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/rido_db

# ─── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ──────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_minimum_32_chars
JWT_EXPIRES_IN=7d

# ─── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_URL=https://rido.app
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# ─── Payments ──────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_your_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_key_here

# ─── SMS (Termii or Sendchamp — Africa-focused) ─────────────────
SMS_PROVIDER=termii
TERMII_API_KEY=your_termii_key_here
TERMII_SENDER_ID=RIDO

# ─── Push Notifications (FCM for Android, APNs for iOS) ─────────
FCM_SERVER_KEY=your_fcm_server_key_here

# ─── Email ─────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@rido.app
SMTP_PASS=your_smtp_password_here
